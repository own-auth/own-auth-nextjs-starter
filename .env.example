# Server-only. Use any Postgres database you control.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/own_auth_starter

# Server-only. Generate with: openssl rand -base64 32
# Rotating this value invalidates existing sessions and auth tokens.
OWN_AUTH_TOKEN_PEPPER=replace-with-a-long-random-secret

# Public origin used to create application-owned auth links.
OWN_AUTH_APP_URL=http://localhost:3000

# Server-only delivery key from the Own Auth dashboard.
OWN_AUTH_EMAIL_DELIVERY_KEY=oa_delivery_replace-with-your-key

# Reserved for the automated test runner. Never enable this in production.
# OWN_AUTH_TEST_MODE=1
